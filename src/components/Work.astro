---
import { getCollection } from 'astro:content';
import ReceiptScrub from './ReceiptScrub.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="section wrap" aria-labelledby="work-title">
  <h2 id="work-title" class="section-title" data-reveal>Work</h2>

  {
    projects.map(({ id, data }) => (
      <article class={`entry entry-${id}`} aria-labelledby={`${id}-title`}>
        <div class="entry-text" data-reveal>
          <div class="entry-head">
            <h3 id={`${id}-title`} style={`view-transition-name: project-${id}`}>
              {data.name}
            </h3>
            <span class:list={['status', { 'is-live': data.status === 'Live 24/7' }]}>{data.status}</span>
          </div>
          <p class="problem">{data.problem}</p>
          <dl class="numbers">
            {data.numbers.slice(0, 3).map((number) => (
              <div>
                <dt class="num">{number.value}</dt>
                <dd>{number.label}</dd>
              </div>
            ))}
          </dl>
          <p class="stack">{data.stack.join(', ')}</p>
          <p class="entry-links">
            <a class="link" href={`/work/${id}`}>
              See how {data.name} works
            </a>
            <a class="link" href={data.repo}>
              Code on GitHub
            </a>
          </p>
        </div>
        <div class="entry-visual" data-reveal style="--reveal-step: 1">
          {id === 'clarityscan' ? (
            <ReceiptScrub />
          ) : (
            <figure class="shot-slot">
              <div class="shot-frame">
                <p>Screenshot to come: a real FilingBot alert in Telegram.</p>
              </div>
            </figure>
          )}
        </div>
      </article>
    ))
  }
</section>

<style>
  .entry {
    display: grid;
    gap: 32px;
  }

  .entry + .entry {
    margin-top: clamp(72px, 9vw, 128px);
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
  }

  h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: -0.015em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .status.is-live::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }

  .problem {
    margin-top: 14px;
    max-width: 44ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .numbers {
    display: grid;
    gap: 18px;
    margin: 28px 0 0;
  }

  .numbers div {
    display: grid;
    grid-template-columns: 5.5em minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
  }

  .numbers dt {
    font-size: var(--text-lead);
    font-weight: 600;
    white-space: nowrap;
  }

  .numbers dd {
    margin: 0;
    color: var(--ink-2);
    max-width: 46ch;
  }

  .stack {
    margin-top: 24px;
    max-width: 60ch;
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 20px;
    font-weight: 600;
  }

  .entry-links a {
    padding-block: 8px;
  }

  .shot-slot {
    margin: 0;
    display: grid;
    place-items: center;
    padding: 32px 16px;
    background: var(--sheet);
    border-radius: 6px;
  }

  .shot-frame {
    display: grid;
    place-items: center;
    width: min(240px, 100%);
    aspect-ratio: 9 / 16;
    padding: 20px;
    background: var(--ground);
    border-radius: 18px;
    text-align: center;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  @media (min-width: 900px) {
    .entry {
      grid-template-columns: 7fr 5fr;
      align-items: center;
      gap: 64px;
    }

    .entry-clarityscan {
      grid-template-columns: 5fr 7fr;
    }

    .entry-clarityscan .entry-visual {
      order: -1;
    }
  }
</style>
