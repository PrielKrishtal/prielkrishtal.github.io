---
import { getEntry } from 'astro:content';
import Diagram from './case/Diagram.astro';
import Todo from './case/Todo.astro';

interface Props {
  id: 'filingbot' | 'clarityscan';
}

const { id } = Astro.props;
const entry = await getEntry('projects', id);
if (!entry) throw new Error(`Missing project data: ${id}`);
const data = entry.data;
const live = data.status === 'Live 24/7';
const fix = data.fixes[0];
---

<section id={id} class="project section wrap" aria-labelledby={`${id}-title`}>
  <header class="head" data-reveal>
    <div class="title-row">
      <h2 id={`${id}-title`}>{data.name}</h2>
      <span class:list={['status', { 'is-live': live }]}>{data.status}</span>
    </div>
    <p class="summary">{data.summary}</p>
    <p class="stack">{data.stack.join(', ')}</p>
    <p class="repo"><a class="link" href={data.repo}>{data.name} on GitHub</a></p>
  </header>

  <div class="visual" data-reveal style="--reveal-step: 1">
    <Diagram spec={data.diagram} name={data.name} />
  </div>

  <dl class="numbers" style={`--count: ${data.numbers.length}`}>
    {
      data.numbers.map((number, index) => (
        <div data-reveal style={`--reveal-step: ${index}`}>
          <dt class="num">{number.value}</dt>
          <dd>{number.label}</dd>
        </div>
      ))
    }
  </dl>

  <div class="details">
    <div class="cards">
      <h3 class="visually-hidden">Decisions</h3>
      <ul>
        {
          data.decisions.map((decision, index) => (
            <li class="card" data-reveal style={`--reveal-step: ${index}`}>
              Chose <strong>{decision.chose}</strong> over {decision.over ?? <Todo>alternative</Todo>}, because{' '}
              {decision.because ?? <Todo>reason</Todo>}
            </li>
          ))
        }
      </ul>
      <h3 class="visually-hidden">Reliability</h3>
      <p class="card fix" data-reveal>
        <span class="broke-line">{fix.broke}</span>
        <span class="fix-line">{fix.fix ?? <Todo>what fixed it</Todo>}</span>
      </p>
    </div>

    <div class="shots">
      <h3 class="visually-hidden">Screenshots</h3>
      {
        data.screenshots.map((shot) => (
          <figure class={`shot shot-${shot.shape}`}>
            <figcaption>{shot.label}</figcaption>
            {shot.src ? (
              <img src={shot.src} alt={shot.alt ?? shot.label} loading="lazy" decoding="async" />
            ) : (
              <div class="frame">
                <Todo>screenshot</Todo>
              </div>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: -0.015em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .status.is-live::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }

  .summary {
    margin-top: 12px;
    max-width: 52ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .stack {
    margin-top: 10px;
    max-width: 72ch;
  }

  .repo {
    margin-top: 10px;
    font-weight: 600;
  }

  .repo a {
    display: inline-block;
    padding-block: 6px;
  }

  .visual {
    margin-top: 28px;
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin: 36px 0 0;
  }

  .numbers dt {
    font-size: var(--text-title);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .numbers dd {
    margin: 8px 0 0;
    max-width: 24ch;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .details {
    display: grid;
    gap: 24px;
    margin-top: 36px;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 14px 18px;
    background: var(--sheet);
    border-radius: 6px;
  }

  .card strong {
    font-weight: 600;
  }

  .fix {
    display: grid;
    gap: 4px;
    margin-top: 10px;
  }

  .fix span {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    align-items: baseline;
  }

  .fix span::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transform: translateY(-1px);
  }

  .broke-line::before {
    background: var(--fail);
  }

  .fix-line::before {
    background: var(--ok);
  }

  .shots {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px;
  }

  .shot {
    margin: 0;
  }

  .shot-phone {
    flex: 0 1 120px;
  }

  .shot-portrait {
    flex: 1 1 120px;
    max-width: 170px;
  }

  .shot-wide {
    flex: 1 1 100%;
  }

  .frame,
  .shot img {
    display: grid;
    place-items: center;
    width: 100%;
    padding: 10px;
    background: var(--sheet);
    border-radius: 8px;
    text-align: center;
    font-size: var(--text-small);
  }

  .shot-phone .frame,
  .shot-phone img {
    aspect-ratio: 9 / 19.5;
    border-radius: 20px;
  }

  .shot-portrait .frame,
  .shot-portrait img {
    aspect-ratio: 3 / 4;
  }

  .shot-wide .frame,
  .shot-wide img {
    aspect-ratio: 2 / 1;
  }

  .shot figcaption {
    margin-bottom: 8px;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  @media (max-width: 759px) {
    .head + .visual {
      margin-top: 20px;
    }

    .numbers {
      margin-top: 24px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px 14px;
    }

    .numbers dt {
      font-size: 1.625rem;
    }

    .numbers > div:nth-child(n + 4) {
      display: none;
    }

    .details {
      margin-top: 24px;
      gap: 18px;
    }

    li.card:nth-child(n + 2) {
      display: none;
    }

    .summary {
      font-size: var(--text-body);
      line-height: var(--text-body--line-height);
      margin-top: 8px;
    }

    .stack {
      margin-top: 8px;
      font-size: var(--text-small);
      line-height: var(--text-small--line-height);
      color: var(--ink-2);
    }

    .repo {
      margin-top: 4px;
    }

    .shot-phone {
      flex-basis: 100px;
    }
  }

  @media (min-width: 760px) {
    .numbers {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .details {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 48px;
      align-items: start;
    }

    .shot-phone {
      flex-basis: 190px;
    }
  }
</style>
