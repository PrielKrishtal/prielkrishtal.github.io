---
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Diagram from './case/Diagram.astro';
import ReceiptScrub from './ReceiptScrub.astro';
import { findScreenshot } from '../lib/images';

interface Props {
  id: 'filingbot' | 'clarityscan';
}

const { id } = Astro.props;
const entry = await getEntry('projects', id);
if (!entry) throw new Error(`Missing project data: ${id}`);
const data = entry.data;
const live = data.status === 'Live 24/7';

const decisions = data.decisions.filter((decision) => decision.because);
const fixes = data.fixes.filter((fix) => fix.fix);
const shots = (
  await Promise.all(
    data.screenshots.map(async (shot) => {
      const image = await findScreenshot(shot.file);
      return image ? { ...shot, image } : null;
    }),
  )
).filter((shot) => shot !== null);
const receipt = data.receipt
  ? {
      ...data.receipt,
      before: await findScreenshot(data.receipt.before),
      after: await findScreenshot(data.receipt.after),
    }
  : null;
const hasCards = decisions.length > 0 || fixes.length > 0;
const hasShots = shots.length > 0 || receipt !== null;
---

<section id={id} class="project section wrap" aria-labelledby={`${id}-title`}>
  <header class="head" data-reveal>
    <div class="title-row">
      <h2 id={`${id}-title`}>{data.name}</h2>
      <span class:list={['status', { 'is-live': live }]}>{data.status}</span>
    </div>
    <p class="summary">{data.summary}</p>
    <p class="stack">{data.stack.join(', ')}</p>
    <p class="repo"><a class="link" href={data.repo}>{data.name} on GitHub</a></p>
  </header>

  <div class="visual" data-reveal style="--reveal-step: 1">
    <Diagram spec={data.diagram} name={data.name} />
  </div>

  <dl class="numbers" style={`--count: ${data.numbers.length}`}>
    {
      data.numbers.map((number, index) => (
        <div data-reveal style={`--reveal-step: ${index}`}>
          <dt class="num">{number.value}</dt>
          <dd>{number.label}</dd>
        </div>
      ))
    }
  </dl>

  {
    (hasCards || hasShots) && (
      <div class:list={['details', { 'is-solo': !(hasCards && hasShots) }]}>
        {hasCards && (
          <div class="cards">
            {decisions.length > 0 && (
              <>
                <h3 class="visually-hidden">Decisions</h3>
                <ul class="decisions">
                  {decisions.map((decision, index) => (
                    <li class="card" data-reveal style={`--reveal-step: ${index}`}>
                      Chose <strong>{decision.chose}</strong>
                      {decision.over ? ` over ${decision.over}` : ''}, because {decision.because}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {fixes.length > 0 && (
              <>
                <h3 class="visually-hidden">Reliability</h3>
                <ul class="fixes">
                  {fixes.map((fix, index) => (
                    <li class="card fix" data-reveal style={`--reveal-step: ${index}`}>
                      <span class="broke-line">{fix.broke}</span>
                      <span class="fix-line">{fix.fix}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        )}

        {hasShots && (
          <div class="shots">
            <h3 class="visually-hidden">Screenshots</h3>
            {receipt && (
              <div class="shot shot-scrub">
                <ReceiptScrub label={receipt.label} before={receipt.before} after={receipt.after} alt={receipt.alt} />
              </div>
            )}
            {shots.map((shot) => (
              <figure class={`shot shot-${shot.shape}`}>
                <figcaption>{shot.label}</figcaption>
                <Picture
                  src={shot.image}
                  alt={shot.alt ?? ''}
                  formats={['avif', 'webp']}
                  widths={[240, 480, 960]}
                  sizes="(min-width: 900px) 40vw, 92vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        )}
      </div>
    )
  }
</section>

<style>
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
  }

  h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    letter-spacing: -0.015em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .status.is-live::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }

  .summary {
    margin-top: 12px;
    max-width: 52ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .stack {
    margin-top: 10px;
    max-width: 72ch;
  }

  .repo {
    margin-top: 10px;
    font-weight: 600;
  }

  .repo a {
    display: inline-block;
    padding-block: 6px;
  }

  .visual {
    margin-top: 28px;
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin: 36px 0 0;
  }

  .numbers dt {
    font-size: var(--text-title);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .numbers dd {
    margin: 8px 0 0;
    max-width: 24ch;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .details {
    display: grid;
    gap: 24px;
    margin-top: 36px;
  }

  .details.is-solo {
    max-width: 720px;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 14px 18px;
    background: var(--sheet);
    border-radius: 6px;
  }

  .card strong {
    font-weight: 600;
  }

  .cards {
    display: grid;
    gap: 10px;
  }

  .fix {
    display: grid;
    gap: 4px;
  }

  .fix span {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    align-items: baseline;
  }

  .fix span::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transform: translateY(-1px);
  }

  .broke-line::before {
    background: var(--fail);
  }

  .fix-line::before {
    background: var(--ok);
  }

  .shots {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 14px;
  }

  .shot {
    margin: 0;
  }

  .shot-scrub {
    flex: 1 1 100%;
  }

  .shot-phone {
    flex: 0 1 160px;
  }

  .shot-portrait {
    flex: 1 1 140px;
    max-width: 220px;
  }

  .shot-wide {
    flex: 1 1 100%;
    max-width: 720px;
  }

  .shot :global(picture),
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .shot figcaption {
    margin-bottom: 8px;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  @media (max-width: 759px) {
    .head + .visual {
      margin-top: 20px;
    }

    .numbers {
      margin-top: 24px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px 14px;
    }

    .numbers dt {
      font-size: 1.625rem;
    }

    .numbers > div:nth-child(n + 4) {
      display: none;
    }

    .details {
      margin-top: 24px;
      gap: 18px;
    }

    .decisions .card:nth-child(n + 2),
    .fixes .card:nth-child(n + 2) {
      display: none;
    }

    .summary {
      font-size: var(--text-body);
      line-height: var(--text-body--line-height);
      margin-top: 8px;
    }

    .stack {
      margin-top: 8px;
      font-size: var(--text-small);
      line-height: var(--text-small--line-height);
      color: var(--ink-2);
    }

    .repo {
      margin-top: 4px;
    }

    .shot-phone {
      flex-basis: 130px;
    }
  }

  @media (min-width: 760px) {
    .numbers {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .details {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 48px;
      align-items: start;
    }

    .shot-phone {
      flex-basis: 200px;
    }
  }
</style>
