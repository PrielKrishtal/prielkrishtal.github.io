---
const stages = [
  { id: 'fetched', title: 'Fetched', detail: 'Polled from SEC EDGAR' },
  { id: 'queued', title: 'Queued', detail: 'Redis Streams, consumer groups' },
  { id: 'classified', title: 'Classified', detail: 'Rules first, then the LLM on Groq' },
  { id: 'validated', title: 'Validated', detail: 'Pydantic schema, one corrective retry' },
  { id: 'stored', title: 'Stored', detail: 'PostgreSQL, duplicates rejected' },
  { id: 'alerted', title: 'Alerted', detail: 'Telegram, high-signal trades only' },
];
---

<section id="pipeline" class="section wrap" aria-labelledby="pipeline-title">
  <div class="belt-head">
    <h2 id="pipeline-title" class="section-title" data-reveal>One filing, end to end</h2>
    <div class="live" data-live data-reveal style="--reveal-step: 1" aria-live="polite">
      <p class="live-state" data-state="checking">
        <span class="dot" aria-hidden="true"></span><span data-state-label>Checking FilingBot</span>
      </p>
      <p class="live-count" data-count-wrap hidden><b class="num" data-count></b> filings processed</p>
      <p class="live-since" data-since-wrap hidden>Last filing <span data-since></span></p>
      <p class="live-source" data-source hidden>Sample data until the live feed is connected</p>
    </div>
  </div>

  <div class="belt" data-belt data-reveal style="--reveal-step: 2">
    <ol class="stages">
      {
        stages.map((stage) => (
          <li class={`stage stage-${stage.id}`} data-stage>
            <div class="obj" aria-hidden="true">
              {stage.id === 'fetched' && <span class="doc" />}
              {stage.id === 'queued' && (
                <span class="pile">
                  <span class="doc" />
                  <span class="doc" />
                  <span class="doc" />
                </span>
              )}
              {stage.id === 'classified' && (
                <span class="doc tagged">
                  <span class="tag">classified</span>
                </span>
              )}
              {stage.id === 'validated' && (
                <span class="record">
                  <i />
                  <i />
                  <i />
                  <span class="mark ok">
                    <svg viewBox="0 0 12 12" width="10" height="10"><path d="M2.5 6.5l2.5 2.5 4.5-6" /></svg>
                  </span>
                  <span class="mark retry">retry</span>
                  <span class="mark fail">
                    <svg viewBox="0 0 12 12" width="10" height="10"><path d="M3 3l6 6M9 3l-6 6" /></svg>
                  </span>
                </span>
              )}
              {stage.id === 'stored' && (
                <span class="rows">
                  <i />
                  <i />
                  <i class="new" />
                </span>
              )}
              {stage.id === 'alerted' && (
                <span class="bubble">
                  Alert
                  <i />
                  <i />
                </span>
              )}
            </div>
            <div class="txt">
              <h3>{stage.title}</h3>
              <p>{stage.detail}</p>
            </div>
            {stage.id === 'validated' && (
              <div class="dlq" data-dlq>
                <span class="tray" aria-hidden="true" data-dlq-point />
                <p>
                  <b>Dead-letter queue</b> if the retry fails too
                </p>
              </div>
            )}
          </li>
        ))
      }
    </ol>
    <span class="traveller" data-traveller aria-hidden="true"></span>
  </div>

  <div class="belt-foot">
    <div class="controls">
      <button class="switch" type="button" role="switch" aria-checked="false" data-fail-switch>
        <span class="track" aria-hidden="true"><span class="thumb"></span></span>
        <span>Send a filing that fails validation</span>
      </button>
      <button class="pause" type="button" aria-pressed="false" data-pause>Pause animation</button>
    </div>
    <p class="note" data-note aria-live="polite">
      The moving filing shows how one filing travels. Status and count come from FilingBot's status feed.
    </p>
  </div>
</section>

<script>
  import { fetchStatus, formatCount, formatSince, type FilingBotStatus } from '../lib/status';

  const configured = import.meta.env.PUBLIC_FILINGBOT_STATUS_URL as string | undefined;
  const statusUrl = configured || '/status.sample.json';
  const source = configured ? 'live' : 'sample';

  const section = document.getElementById('pipeline')!;
  const belt = section.querySelector<HTMLElement>('[data-belt]')!;
  const stageEls = [...section.querySelectorAll<HTMLElement>('[data-stage]')];
  const objects = stageEls.map((stage) => stage.querySelector<HTMLElement>('.obj')!);
  const dlq = section.querySelector<HTMLElement>('[data-dlq]')!;
  const dlqPoint = section.querySelector<HTMLElement>('[data-dlq-point]')!;
  const traveller = section.querySelector<HTMLElement>('[data-traveller]')!;
  const failSwitch = section.querySelector<HTMLButtonElement>('[data-fail-switch]')!;
  const pauseButton = section.querySelector<HTMLButtonElement>('[data-pause]')!;
  const note = section.querySelector<HTMLElement>('[data-note]')!;
  const live = section.querySelector<HTMLElement>('[data-live]')!;
  const stateWrap = live.querySelector<HTMLElement>('[data-state]')!;
  const stateLabel = live.querySelector<HTMLElement>('[data-state-label]')!;
  const countWrap = live.querySelector<HTMLElement>('[data-count-wrap]')!;
  const countEl = live.querySelector<HTMLElement>('[data-count]')!;
  const sinceWrap = live.querySelector<HTMLElement>('[data-since-wrap]')!;
  const sinceEl = live.querySelector<HTMLElement>('[data-since]')!;
  const sourceEl = live.querySelector<HTMLElement>('[data-source]')!;

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const HOP_MS = 600;
  const HOLD_MS = 520;
  const REST_MS = 1400;
  const STATE_LABELS = { up: 'Running now', degraded: 'Degraded', unknown: 'No live reading right now' } as const;
  const DEFAULT_NOTE = note.textContent?.trim() ?? '';

  let status: FilingBotStatus | null = null;
  let failMode = false;
  let paused = false;
  let inView = false;
  let looping = false;
  let pendingReal = 0;
  let points: { x: number; y: number }[] = [];
  let dlqTarget = { x: 0, y: 0 };
  let current = { x: 0, y: 0 };

  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  const motionAllowed = () => !reduceMotion.matches && !paused && inView && document.visibilityState === 'visible';
  const canMove = () => motionAllowed() && status?.state !== 'unknown';
  const speed = () => (status?.state === 'degraded' ? 1.6 : 1);

  function centerOf(el: HTMLElement) {
    const box = el.getBoundingClientRect();
    const frame = belt.getBoundingClientRect();
    return { x: box.left - frame.left + box.width / 2, y: box.top - frame.top + box.height / 2 };
  }

  function measure() {
    points = objects.map(centerOf);
    dlqTarget = centerOf(dlqPoint);
  }

  function place(point: { x: number; y: number }) {
    current = point;
    traveller.style.transform = `translate(${point.x}px, ${point.y}px)`;
  }

  async function hop(to: { x: number; y: number }) {
    const from = current;
    const animation = traveller.animate(
      [{ transform: `translate(${from.x}px, ${from.y}px)` }, { transform: `translate(${to.x}px, ${to.y}px)` }],
      { duration: HOP_MS * speed(), easing: 'cubic-bezier(0.77, 0, 0.175, 1)', fill: 'forwards' },
    );
    await animation.finished.catch(() => {});
    animation.cancel();
    place(to);
  }

  function clearStages() {
    stageEls.forEach((stage) => stage.classList.remove('is-active', 'is-failing', 'is-failed'));
    dlq.classList.remove('is-active');
  }

  async function travel(real: boolean) {
    measure();
    clearStages();
    traveller.classList.toggle('is-real', real);
    place(points[0]);
    traveller.classList.add('is-visible');
    if (real) note.textContent = 'A new filing was just processed.';

    for (let i = 0; i < points.length; i++) {
      if (i > 0) await hop(points[i]);
      stageEls.forEach((stage, index) => stage.classList.toggle('is-active', index === i));
      const validated = stageEls[i].classList.contains('stage-validated');
      if (validated && failMode) {
        stageEls[i].classList.add('is-failing');
        await sleep(900 * speed());
        stageEls[i].classList.replace('is-failing', 'is-failed');
        await sleep(300);
        await hop(dlqTarget);
        dlq.classList.add('is-active');
        await sleep(HOLD_MS * 2);
        break;
      }
      await sleep(HOLD_MS * speed());
    }

    traveller.classList.remove('is-visible');
    await sleep(200);
    clearStages();
    if (real) note.textContent = DEFAULT_NOTE;
  }

  async function loop() {
    if (looping) return;
    looping = true;
    while (canMove() || (pendingReal > 0 && motionAllowed())) {
      const real = pendingReal > 0;
      if (real) pendingReal--;
      await travel(real);
      await sleep(REST_MS);
    }
    looping = false;
  }

  function renderStatic() {
    belt.dataset.fail = failMode ? 'on' : 'off';
  }

  failSwitch.addEventListener('click', () => {
    failMode = !failMode;
    failSwitch.setAttribute('aria-checked', String(failMode));
    renderStatic();
  });

  pauseButton.addEventListener('click', () => {
    paused = !paused;
    pauseButton.setAttribute('aria-pressed', String(paused));
    pauseButton.textContent = paused ? 'Play animation' : 'Pause animation';
    if (!paused) loop();
  });

  function render(next: FilingBotStatus) {
    const previous = status?.filingsProcessed ?? null;
    status = next;
    stateWrap.dataset.state = next.state;
    stateLabel.textContent = STATE_LABELS[next.state];

    countWrap.hidden = next.filingsProcessed === null;
    if (next.filingsProcessed !== null) {
      const text = formatCount(next.filingsProcessed);
      if (countEl.textContent && countEl.textContent !== text && !reduceMotion.matches) {
        countEl.animate(
          [{ opacity: 0, transform: 'translateY(-6px)' }, { opacity: 1, transform: 'none' }],
          { duration: 200, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
        );
      }
      countEl.textContent = text;
    }
    renderSince();
    sourceEl.hidden = next.source !== 'sample';

    if (previous !== null && next.filingsProcessed !== null && next.filingsProcessed > previous) {
      pendingReal = Math.min(3, pendingReal + next.filingsProcessed - previous);
    }
    loop();
  }

  function renderSince() {
    const at = status?.lastFilingAt ?? null;
    sinceWrap.hidden = at === null;
    if (at) sinceEl.textContent = formatSince(at);
  }

  async function refresh() {
    if (document.visibilityState !== 'visible') return;
    render(await fetchStatus(statusUrl, source));
  }

  new IntersectionObserver(
    ([entry]) => {
      inView = entry.isIntersecting;
      if (inView) loop();
    },
    { threshold: 0.35 },
  ).observe(belt);

  new ResizeObserver(() => {
    measure();
    if (!traveller.classList.contains('is-visible')) place(points[0]);
  }).observe(belt);

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') {
      refresh();
      loop();
    }
  });
  reduceMotion.addEventListener('change', () => loop());

  renderStatic();
  refresh();
  setInterval(refresh, 60_000);
  setInterval(renderSince, 30_000);
</script>

<style>
  .belt-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px 48px;
    margin-bottom: 28px;
  }

  .belt-head .section-title {
    margin-bottom: 0;
  }

  .live {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 24px;
    color: var(--ink-2);
  }

  .live-state {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 600;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink-2);
  }

  [data-state='up'] .dot {
    background: var(--ok);
  }

  [data-state='degraded'] .dot {
    background: var(--fail);
  }

  .live-count b {
    color: var(--ink);
    font-size: var(--text-lead);
    font-weight: 600;
    margin-right: 4px;
    display: inline-block;
  }

  .live-source {
    font-size: var(--text-small);
  }

  .belt {
    position: relative;
    background: var(--sheet);
    border-radius: 6px;
    padding: 28px 24px;
  }

  .stages {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .stages::before {
    content: '';
    position: absolute;
    top: 43px;
    left: calc(100% / 12);
    right: calc(100% / 12);
    height: 2px;
    background: var(--ink);
  }

  .stage {
    position: relative;
  }

  .obj {
    position: relative;
    width: 88px;
    height: 88px;
    margin-inline: auto;
    display: grid;
    place-items: center;
    background: var(--sheet);
    transition: transform 200ms var(--ease-out);
  }

  .stage.is-active .obj {
    transform: translateY(-4px);
  }

  .txt {
    margin-top: 12px;
  }

  h3 {
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.3;
  }

  .txt p,
  .dlq p {
    margin-top: 2px;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .doc {
    position: relative;
    display: block;
    width: 40px;
    height: 52px;
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 2px;
  }

  .doc::before,
  .doc::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
  }

  .doc::before {
    top: 8px;
    height: 3px;
    background: var(--bar);
  }

  .doc::after {
    top: 16px;
    height: 13px;
    border-top: 3px solid var(--bar);
    border-bottom: 3px solid var(--bar);
  }

  .pile {
    position: relative;
    width: 56px;
    height: 64px;
  }

  .pile .doc {
    position: absolute;
  }

  .pile .doc:nth-child(1) { left: 0; top: 12px; }
  .pile .doc:nth-child(2) { left: 7px; top: 6px; }
  .pile .doc:nth-child(3) { left: 14px; top: 0; }

  .tag {
    position: absolute;
    left: 50%;
    bottom: -9px;
    transform: translateX(-50%);
    padding: 1px 6px;
    background: var(--blue);
    color: var(--sheet);
    border-radius: 3px;
    font-size: 10px;
    font-weight: 600;
    white-space: nowrap;
  }

  .record {
    position: relative;
    display: grid;
    gap: 5px;
    width: 64px;
    padding: 9px 8px;
    background: var(--card);
    border-radius: 5px;
    transition: background-color 200ms ease;
  }

  .record i {
    display: block;
    height: 5px;
    background: var(--extract);
    border-radius: 1px;
  }

  .record i:nth-child(2) { width: 60%; }
  .record i:nth-child(3) { width: 80%; }

  .mark {
    position: absolute;
    right: -8px;
    top: -9px;
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    color: var(--sheet);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .mark svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mark.ok { background: var(--ok); }
  .mark.retry { background: var(--fail); }
  .mark.fail { background: var(--fail); }

  .stage-validated.is-active .mark.ok,
  .stage-validated.is-failing .mark.retry,
  .stage-validated.is-failed .mark.fail {
    opacity: 1;
  }

  .stage-validated.is-failing .mark.ok,
  .stage-validated.is-failed .mark.ok {
    opacity: 0;
  }

  .stage-validated.is-failing .record,
  .stage-validated.is-failed .record {
    background: var(--fail);
  }

  .rows {
    display: grid;
    gap: 3px;
    width: 64px;
  }

  .rows i {
    display: block;
    height: 12px;
    background: var(--ground);
    border-radius: 1px;
  }

  .rows i.new {
    background: var(--extract);
    opacity: 0.35;
    transition: opacity 200ms ease;
  }

  .stage-stored.is-active .rows i.new {
    opacity: 1;
  }

  .bubble {
    width: 72px;
    padding: 7px 9px;
    border-radius: 12px 12px 12px 3px;
    background: var(--blue);
    color: var(--sheet);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
  }

  .bubble i {
    display: block;
    height: 4px;
    margin-top: 4px;
    background: currentColor;
    opacity: 0.55;
    border-radius: 1px;
  }

  .bubble i:last-child { width: 60%; }

  .dlq {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }

  .tray {
    width: 36px;
    height: 22px;
    border: 2px solid var(--fail);
    border-top-width: 0;
    border-radius: 0 0 4px 4px;
    transition: background-color 200ms ease;
  }

  .dlq b {
    color: var(--ink);
    font-weight: 600;
  }

  .dlq.is-active .tray {
    background: var(--fail);
  }

  .traveller {
    position: absolute;
    left: -7px;
    top: -9px;
    width: 14px;
    height: 18px;
    background: var(--ink);
    border-radius: 2px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
    z-index: 2;
  }

  .traveller.is-real {
    background: var(--blue);
  }

  .traveller.is-visible {
    opacity: 1;
  }

  .belt-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: 20px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 28px;
  }

  .pause {
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--bar);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pause {
      display: none;
    }
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    font-weight: 600;
    text-align: left;
  }

  .track {
    position: relative;
    flex: none;
    width: 46px;
    height: 26px;
    border-radius: 999px;
    background: var(--bar);
    transition: background-color 180ms ease;
  }

  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    transition: transform 180ms var(--ease-out);
  }

  .switch[aria-checked='true'] .track {
    background: var(--fail);
  }

  .switch[aria-checked='true'] .thumb {
    transform: translateX(20px);
  }

  .switch:active .thumb {
    transform: scale(0.94);
  }

  .switch[aria-checked='true']:active .thumb {
    transform: translateX(20px) scale(0.94);
  }

  .note {
    max-width: 60ch;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  @media (prefers-reduced-motion: reduce) {
    .traveller {
      display: none;
    }

    [data-fail='on'] .stage-validated .record,
    [data-fail='on'] .tray {
      background: var(--fail);
    }

    [data-fail='on'] .stage-validated .mark.fail {
      opacity: 1;
    }
  }

  @media (max-width: 899px) {
    .belt {
      padding: 20px 16px;
    }

    .stages {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .stages::before {
      top: 44px;
      bottom: 44px;
      left: 43px;
      right: auto;
      width: 2px;
      height: auto;
    }

    .stage {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      column-gap: 16px;
      align-items: center;
    }

    .obj {
      margin-inline: 0;
    }

    .txt {
      margin-top: 0;
    }

    .dlq {
      grid-column: 2;
      margin-top: 8px;
    }
  }
</style>
