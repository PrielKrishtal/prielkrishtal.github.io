---
import type { CollectionEntry } from 'astro:content';

type Spec = CollectionEntry<'projects'>['data']['diagram'];
type Column = Spec['columns'][number];
type Node = Pick<Column, 'id' | 'label' | 'detail' | 'external'>;

interface Props {
  spec: Spec;
  name: string;
}

const { spec, name } = Astro.props;
const { columns, boundary, band, states, paths, live } = spec;
const count = columns.length;

const insideFree = (index: number) => index >= boundary.from && index <= boundary.to && !columns[index].above && !columns[index].below;
let runStart = -1;
let runEnd = -1;
for (let index = boundary.from; index <= boundary.to; index++) {
  if (!insideFree(index)) {
    if (runStart !== -1) break;
    continue;
  }
  if (runStart === -1) runStart = index;
  runEnd = index;
}
const footerBesideFreeRows = runStart !== -1 && runEnd > runStart;
const shift = footerBesideFreeRows ? 0 : 1;
const footerMobileRow = footerBesideFreeRows ? `${runStart + 1} / ${runEnd + 2}` : String(boundary.to + 2);
const boundaryEndRow = footerBesideFreeRows ? boundary.to + 2 : boundary.to + 3;

interface Placed {
  node: Node;
  kind: 'main' | 'above' | 'below';
  last: boolean;
  style: string;
}

const placed: Placed[] = columns.flatMap((column, index) => {
  const desktopColumn = index + 1;
  const row = index <= boundary.to ? index + 1 : index + 1 + shift;
  const items: Placed[] = [];
  if (column.above) {
    items.push({ node: column.above, kind: 'above', last: false, style: `--dc:${desktopColumn};--dr:1;--mc:2;--mr:${row}` });
  }
  items.push({ node: column, kind: 'main', last: index === count - 1, style: `--dc:${desktopColumn};--dr:2;--mc:1;--mr:${row}` });
  if (column.below) {
    items.push({ node: column.below, kind: 'below', last: false, style: `--dc:${desktopColumn};--dr:3;--mc:2;--mr:${row}` });
  }
  return items;
});

const boundaryStyle = `--dc:${boundary.from + 1} / ${boundary.to + 2};--dr:2 / 5;--mc:1 / 3;--mr:${boundary.from + 1} / ${boundaryEndRow}`;
const footerStyle = `--dc:${boundary.from + 1} / ${boundary.to + 2};--dr:4;--mc:${footerBesideFreeRows ? '2' : '1 / 3'};--mr:${footerMobileRow}`;
const pathData = JSON.stringify(paths.map(({ id, note, steps }) => ({ id, note, steps })));
const liveNote = 'The moving filing shows how one filing travels.';
---

<figure class="dg" data-diagram data-mode={live ? 'live' : 'paths'} data-paths={pathData} style={`--cols:${count}`}>
  {
    live ? (
      <div class="status" data-status="checking" aria-live="polite">
        <p class="status-state">
          <span class="dot" aria-hidden="true" />
          <span data-status-label>Checking {name}</span>
        </p>
        <p data-count-wrap hidden>
          <b class="num" data-count /> filings processed
        </p>
        <p data-since-wrap hidden>
          Last filing <span data-since />
        </p>
      </div>
    ) : (
      <div class="controls" role="group" aria-label={`Follow a path through ${name}`}>
        {paths.map((path, index) => (
          <button type="button" class="path-button" data-path={path.id} aria-pressed={index === 0 ? 'true' : 'false'}>
            {path.label}
          </button>
        ))}
      </div>
    )
  }

  <div class="grid">
    <div class="boundary" style={boundaryStyle} aria-hidden="true"></div>
    {live && <span class="packet" data-packet aria-hidden="true" />}
    {
      placed.map(({ node, kind, last, style }) => (
        <div class:list={['node', `is-${kind}`, { 'is-external': node.external, 'is-last': last }]} data-node={node.id} style={style}>
          <span class="wire" aria-hidden="true" />
          <b>{node.label}</b>
          <span>{node.detail}</span>
          <i class="retry-mark" aria-hidden="true">retry</i>
          <i class="end-mark" aria-hidden="true">
            <svg viewBox="0 0 12 12" width="10" height="10">
              <path d="M3 3l6 6M9 3l-6 6" />
            </svg>
          </i>
        </div>
      ))
    }
    <div class="footer" style={footerStyle}>
      <b>{boundary.label}</b>
      {band && <span>{band}</span>}
    </div>
  </div>

  {
    states && (
      <ol class="states" aria-label="States">
        {states.map((state) => (
          <li data-state-item={state}>{state}</li>
        ))}
      </ol>
    )
  }

  {
    live && (
      <div class="live-controls">
        <button class="switch" type="button" role="switch" aria-checked="false" data-fail-switch>
          <span class="track" aria-hidden="true">
            <span class="thumb" />
          </span>
          <span>Send a filing that fails validation</span>
        </button>
        <button class="path-button" type="button" data-duplicate>
          Send a duplicate filing
        </button>
        <button class="pause" type="button" aria-pressed="false" data-pause>
          Pause animation
        </button>
      </div>
    )
  }

  <p class="note" data-note aria-live="polite">{live ? liveNote : paths[0].note}</p>
  <figcaption class="visually-hidden">{spec.caption}</figcaption>
</figure>

<script>
  import '../../scripts/diagram.ts';
</script>

<style>
  .dg {
    margin: 0;
    padding: clamp(20px, 3vw, 32px);
    background: var(--sheet);
    border-radius: 6px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  :global(:root:not(.js)) .controls {
    display: none;
  }

  .path-button {
    min-height: 40px;
    padding: 0 16px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    font-size: var(--text-small);
    font-weight: 600;
    transition:
      transform 160ms var(--ease-out),
      background-color 150ms ease,
      color 150ms ease;
  }

  .path-button:active {
    transform: scale(0.97);
  }

  .path-button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--sheet);
  }

  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 22px;
    margin-bottom: 24px;
    color: var(--ink-2);
  }

  .status-state {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 600;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink-2);
  }

  [data-status='up'] .dot {
    background: var(--ok);
  }

  [data-status='sample'] .dot {
    background: var(--ink-2);
  }

  [data-status='degraded'] .dot {
    background: var(--fail);
  }

  .status b {
    display: inline-block;
    margin-right: 4px;
    color: var(--ink);
    font-size: var(--text-lead);
    font-weight: 600;
  }

  .packet {
    position: absolute;
    left: -6px;
    top: -6px;
    z-index: 0;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--ink);
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }

  .packet.is-real {
    background: var(--blue);
  }

  .packet.is-visible {
    opacity: 1;
  }

  .node.is-active::before {
    opacity: 1;
    transition-delay: 0ms;
    transition-duration: 150ms;
  }

  .retry-mark {
    position: absolute;
    top: -11px;
    right: 14px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--fail);
    color: var(--sheet);
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .node.is-retry .retry-mark {
    opacity: 1;
  }

  .live-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 24px;
    margin-top: 28px;
  }

  :global(:root:not(.js)) .live-controls {
    display: none;
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    font-weight: 600;
    text-align: left;
  }

  .track {
    position: relative;
    flex: none;
    width: 46px;
    height: 26px;
    border-radius: 999px;
    background: var(--bar);
    transition: background-color 180ms ease;
  }

  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    transition: transform 180ms var(--ease-out);
  }

  .switch[aria-checked='true'] .track {
    background: var(--fail);
  }

  .switch[aria-checked='true'] .thumb {
    transform: translateX(20px);
  }

  .switch:active .thumb {
    transform: scale(0.94);
  }

  .switch[aria-checked='true']:active .thumb {
    transform: translateX(20px) scale(0.94);
  }

  .pause {
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--bar);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .packet,
    .pause {
      display: none;
    }
  }

  .grid {
    --gap-x: 28px;
    --gap-y: 24px;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: auto auto auto auto;
    column-gap: var(--gap-x);
    row-gap: var(--gap-y);
    align-items: center;
    position: relative;
  }

  .boundary,
  .node,
  .footer {
    grid-column: var(--dc);
    grid-row: var(--dr);
  }

  .boundary {
    align-self: stretch;
    margin: -14px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .node {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2px;
    align-content: start;
    padding: 12px 14px;
    background: var(--sheet);
    border: 2px solid var(--ink);
    border-radius: 6px;
    transition:
      border-color 200ms ease,
      color 200ms ease;
    transition-delay: var(--d, 0ms);
  }

  .node span {
    transition: color 200ms ease;
    transition-delay: var(--d, 0ms);
  }

  .node.is-external {
    border-color: var(--ink-2);
  }

  .node b {
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.3;
  }

  .node span {
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: 1.35;
  }

  .wire {
    position: absolute;
    background: var(--ink);
    pointer-events: none;
  }

  .node::before {
    content: '';
    position: absolute;
    inset: -6px;
    border: 2px solid var(--blue);
    border-radius: 9px;
    opacity: 0;
    transition: opacity 260ms var(--ease-out);
    transition-delay: var(--d, 0ms);
  }

  .node.is-lit::before {
    opacity: 1;
  }

  .node.is-end-fail::before {
    border-color: var(--fail);
  }

  .end-mark {
    position: absolute;
    top: -10px;
    right: -10px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--fail);
    color: var(--sheet);
    opacity: 0;
    transition: opacity 200ms ease;
    transition-delay: var(--d, 0ms);
  }

  .end-mark svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .node.is-end-fail .end-mark {
    opacity: 1;
  }

  [data-active] .node:not(.is-lit) {
    border-color: var(--bar);
    color: var(--ink-2);
  }


  .footer {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2px;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .footer span {
    color: var(--ink-2);
  }

  .states {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .states li {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--ground);
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 600;
    transition:
      background-color 200ms ease,
      color 200ms ease;
    transition-delay: var(--d, 0ms);
  }

  .states li.is-lit {
    color: var(--ink);
  }

  .states li.is-current {
    background: var(--blue);
    color: var(--sheet);
  }

  .states li.is-current.is-end-fail {
    background: var(--fail);
  }

  .note {
    margin-top: 20px;
    min-height: 1.55em;
    font-weight: 600;
  }

  figcaption {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: var(--text-small);
  }

  @media (min-width: 900px) {
    .is-main:not(.is-last) > .wire {
      left: 100%;
      top: 50%;
      width: var(--gap-x);
      height: 2px;
    }

    .is-above > .wire {
      top: 100%;
      left: 50%;
      width: 2px;
      height: var(--gap-y);
    }

    .is-below > .wire {
      bottom: 100%;
      left: 50%;
      width: 2px;
      height: var(--gap-y);
    }
  }

  @media (max-width: 899px) {
    .dg {
      padding: 16px;
    }

    .status {
      margin-bottom: 14px;
      gap: 2px 18px;
    }

    .states {
      gap: 6px;
      margin-top: 16px;
    }

    .states li {
      padding: 3px 10px;
      font-size: var(--text-small);
    }

    .footer {
      align-self: start;
      line-height: 1.35;
    }

    .note {
      font-size: 15px;
    }

    .controls {
      margin-bottom: 16px;
    }

    .node {
      padding: 8px 12px;
    }

    .live-controls {
      margin-top: 16px;
      gap: 2px 20px;
    }

    .note {
      margin-top: 12px;
      min-height: 0;
    }

    .grid {
      --gap-x: 16px;
      --gap-y: 12px;
      position: relative;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
      grid-template-rows: none;
      grid-auto-rows: auto;
      align-items: stretch;
    }

    .boundary,
    .node,
    .footer {
      grid-column: var(--mc);
      grid-row: var(--mr);
    }

    .is-main:not(.is-last) > .wire {
      top: 100%;
      left: 50%;
      width: 2px;
      height: var(--gap-y);
    }

    .footer {
      align-self: center;
    }

    .is-above > .wire,
    .is-below > .wire {
      right: 100%;
      top: 50%;
      width: var(--gap-x);
      height: 2px;
    }
  }
</style>
