<figure class="scrub-figure" data-scrub-figure>
  <div class="receipt-stage" aria-hidden="true">
    <div class="receipt" data-receipt>
      <div class="ink grey">
        <i class="w-60"></i><i class="w-40"></i><i></i><i class="w-80"></i><i></i><i class="w-60"></i><i class="w-80"></i>
        <i class="total"></i>
      </div>
      <div class="ink sharp" data-sharp>
        <i class="w-60"></i><i class="w-40"></i><i></i><i class="w-80"></i><i></i><i class="w-60"></i><i class="w-80"></i>
        <i class="total"></i>
      </div>
      <div class="shade" data-shade></div>
    </div>
  </div>

  <div class="control">
    <span aria-hidden="true">As photographed</span>
    <input
      type="range"
      min="0"
      max="100"
      value="100"
      step="1"
      data-scrub
      aria-label="Receipt correction, from as photographed to after a 4-point homography"
    />
    <span aria-hidden="true">Corrected</span>
  </div>

  <figcaption>
    A drawing of ClarityScan's OpenCV preprocessing: Gaussian blur, Otsu thresholding, then a 4-point homography that
    flattens the receipt.
  </figcaption>
</figure>

<script>
  const figure = document.querySelector<HTMLElement>('[data-scrub-figure]');
  const receipt = figure?.querySelector<HTMLElement>('[data-receipt]');
  const sharp = figure?.querySelector<HTMLElement>('[data-sharp]');
  const shade = figure?.querySelector<HTMLElement>('[data-shade]');
  const input = figure?.querySelector<HTMLInputElement>('[data-scrub]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

  function apply(progress: number) {
    if (!receipt || !sharp || !shade) return;
    const skew = 1 - progress;
    receipt.style.transform =
      `perspective(600px) rotateX(${16 * skew}deg) rotateZ(${-10 * skew}deg) skewX(${5 * skew}deg) scale(${1 - 0.08 * skew})`;
    shade.style.opacity = String(0.22 * skew);
    sharp.style.opacity = String(clamp((progress - 0.45) / 0.55));
  }

  let autoplay = 0;

  function stopAutoplay() {
    cancelAnimationFrame(autoplay);
    autoplay = 0;
  }

  function play() {
    if (!input) return;
    const start = performance.now();
    const duration = 1400;
    const step = (now: number) => {
      const t = clamp((now - start) / duration);
      const progress = easeInOut(t);
      input.value = String(Math.round(progress * 100));
      apply(progress);
      autoplay = t < 1 ? requestAnimationFrame(step) : 0;
    };
    autoplay = requestAnimationFrame(step);
  }

  if (figure && input) {
    input.addEventListener('input', () => {
      stopAutoplay();
      apply(Number(input.value) / 100);
    });
    ['pointerdown', 'keydown'].forEach((type) => input.addEventListener(type, stopAutoplay));

    if (reduceMotion.matches) {
      apply(1);
    } else {
      input.value = '0';
      apply(0);
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          setTimeout(play, 300);
        },
        { threshold: 0.6 },
      );
      observer.observe(figure);
    }
  }
</script>

<style>
  .scrub-figure {
    margin: 0;
  }

  .receipt-stage {
    display: grid;
    place-items: center;
    padding: 36px 16px;
    background: var(--sheet);
    border-radius: 6px;
    overflow: hidden;
  }

  .receipt {
    position: relative;
    width: 150px;
    height: 220px;
    padding: 18px 16px;
    background: var(--paper);
    border-radius: 2px;
    transform-origin: 50% 60%;
    transform: none;
  }

  .ink {
    position: absolute;
    inset: 18px 16px;
    display: grid;
    align-content: start;
    gap: 9px;
  }

  .ink i {
    display: block;
    height: 7px;
    border-radius: 1px;
  }

  .grey i {
    background: var(--paper-ink-2);
    opacity: 0.45;
  }

  .sharp i {
    background: var(--paper-ink);
  }

  .ink i.total {
    height: 12px;
    width: 50%;
    margin-top: 12px;
  }

  .w-40 { width: 40%; }
  .w-60 { width: 60%; }
  .w-80 { width: 80%; }

  .shade {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    border-radius: inherit;
  }

  .control {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    color: var(--ink-2);
    font-size: var(--text-small);
  }

  input[type='range'] {
    width: 100%;
    min-height: 44px;
    accent-color: var(--blue);
    touch-action: pan-y;
  }

  figcaption {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    max-width: 52ch;
  }
</style>
