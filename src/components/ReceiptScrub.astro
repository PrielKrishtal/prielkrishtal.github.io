---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  before?: ImageMetadata | null;
  after?: ImageMetadata | null;
  alt?: string;
}

const { label, before, after, alt = '' } = Astro.props;
const photo = before && after ? { before, after } : null;
const caption = photo
  ? 'Drag the slider to compare the photo with the corrected receipt.'
  : "A drawing of ClarityScan's OpenCV preprocessing: Gaussian blur, Otsu thresholding, then a 4-point homography that flattens the receipt.";
---

<figure class="scrub-figure" data-scrub-figure data-mode={photo ? 'photo' : 'drawn'}>
  <figcaption>{label}</figcaption>

  {
    photo ? (
      <div class="photo-stage" style={`aspect-ratio: ${photo.before.width} / ${photo.before.height}`}>
        <Picture src={photo.before} alt={alt} formats={['avif', 'webp']} widths={[360, 720, 1080]} sizes="(min-width: 900px) 40vw, 92vw" loading="lazy" decoding="async" />
        <div class="after" data-after>
          <Picture src={photo.after} alt="" formats={['avif', 'webp']} widths={[360, 720, 1080]} sizes="(min-width: 900px) 40vw, 92vw" loading="lazy" decoding="async" />
        </div>
      </div>
    ) : (
      <div class="receipt-stage" aria-hidden="true">
        <div class="receipt" data-receipt>
          <div class="ink grey">
            <i class="w-60" />
            <i class="w-40" />
            <i />
            <i class="w-80" />
            <i />
            <i class="w-60" />
            <i class="w-80" />
            <i class="total" />
          </div>
          <div class="ink sharp" data-sharp>
            <i class="w-60" />
            <i class="w-40" />
            <i />
            <i class="w-80" />
            <i />
            <i class="w-60" />
            <i class="w-80" />
            <i class="total" />
          </div>
          <div class="shade" data-shade />
        </div>
      </div>
    )
  }

  <div class="control">
    <span aria-hidden="true">As photographed</span>
    <input
      type="range"
      min="0"
      max="100"
      value="100"
      step="1"
      data-scrub
      aria-label="Receipt correction, from as photographed to corrected"
    />
    <span aria-hidden="true">Corrected</span>
  </div>

  <p class="caption">{caption}</p>
</figure>

<script>
  const figure = document.querySelector<HTMLElement>('[data-scrub-figure]');
  const input = figure?.querySelector<HTMLInputElement>('[data-scrub]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

  function drawnApply(progress: number) {
    const receipt = figure!.querySelector<HTMLElement>('[data-receipt]')!;
    const sharp = figure!.querySelector<HTMLElement>('[data-sharp]')!;
    const shade = figure!.querySelector<HTMLElement>('[data-shade]')!;
    const skew = 1 - progress;
    receipt.style.transform = `perspective(600px) rotateX(${16 * skew}deg) rotateZ(${-10 * skew}deg) skewX(${5 * skew}deg) scale(${1 - 0.08 * skew})`;
    shade.style.opacity = String(0.22 * skew);
    sharp.style.opacity = String(clamp((progress - 0.45) / 0.55));
  }

  function photoApply(progress: number) {
    const after = figure!.querySelector<HTMLElement>('[data-after]')!;
    after.style.clipPath = `inset(0 ${(1 - progress) * 100}% 0 0)`;
  }

  const apply = figure?.dataset.mode === 'photo' ? photoApply : drawnApply;

  function describe(progress: number) {
    if (!input) return;
    input.setAttribute('aria-valuetext', progress >= 0.99 ? 'Corrected' : progress <= 0.01 ? 'As photographed' : `${Math.round(progress * 100)}% corrected`);
  }

  let autoplay = 0;

  function stopAutoplay() {
    cancelAnimationFrame(autoplay);
    autoplay = 0;
  }

  function play() {
    if (!input) return;
    const start = performance.now();
    const duration = 1400;
    const step = (now: number) => {
      const t = clamp((now - start) / duration);
      const progress = easeInOut(t);
      input.value = String(Math.round(progress * 100));
      apply(progress);
      describe(progress);
      autoplay = t < 1 ? requestAnimationFrame(step) : 0;
    };
    autoplay = requestAnimationFrame(step);
  }

  if (figure && input) {
    input.addEventListener('input', () => {
      stopAutoplay();
      const progress = Number(input.value) / 100;
      apply(progress);
      describe(progress);
    });
    ['pointerdown', 'keydown'].forEach((type) => input.addEventListener(type, stopAutoplay));

    if (reduceMotion.matches) {
      apply(1);
      describe(1);
    } else {
      input.value = '0';
      apply(0);
      describe(0);
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          setTimeout(play, 300);
        },
        { threshold: 0.6 },
      );
      observer.observe(figure);
    }
  }
</script>

<style>
  .scrub-figure {
    margin: 0;
  }

  figcaption {
    margin-bottom: 8px;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .receipt-stage {
    display: grid;
    place-items: center;
    padding: 28px 16px;
    background: var(--sheet);
    border-radius: 6px;
    overflow: hidden;
  }

  .receipt {
    position: relative;
    width: 130px;
    height: 190px;
    padding: 16px 14px;
    background: var(--paper);
    border-radius: 2px;
    transform-origin: 50% 60%;
  }

  .ink {
    position: absolute;
    inset: 16px 14px;
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .ink i {
    display: block;
    height: 6px;
    border-radius: 1px;
  }

  .grey i {
    background: var(--paper-ink-2);
    opacity: 0.45;
  }

  .sharp i {
    background: var(--paper-ink);
  }

  .ink i.total {
    height: 11px;
    width: 50%;
    margin-top: 10px;
  }

  .w-40 { width: 40%; }
  .w-60 { width: 60%; }
  .w-80 { width: 80%; }

  .shade {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    border-radius: inherit;
  }

  .photo-stage {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: var(--sheet);
  }

  .photo-stage :global(picture),
  .photo-stage :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 0);
  }

  .control {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    color: var(--ink-2);
    font-size: var(--text-small);
  }

  input[type='range'] {
    width: 100%;
    min-height: 44px;
    accent-color: var(--blue);
    touch-action: pan-y;
  }

  .caption {
    margin-top: 2px;
    color: var(--ink-2);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    max-width: 52ch;
  }

  @media (max-width: 759px) {
    .receipt-stage {
      padding: 16px;
    }

    .control {
      margin-top: 4px;
    }
  }
</style>
