---
import { education, languages, profile } from '../data/profile';
---

<section id="about" class="section wrap" aria-labelledby="about-title">
  <div class="about">
    <h2 id="about-title" class="section-title" data-reveal>About</h2>
    <div class="about-body" data-reveal style="--reveal-step: 1">
      <p class="bio">
        I'm a final-year computer science student at Afeka College of Engineering. I build backend and LLM systems in
        Python and run them in production. FilingBot runs 24/7 on an Oracle Cloud VM with schema validation, a
        dead-letter queue and Sentry on four services. I'm looking for a part-time student role, Python/backend first,
        alongside my studies.
      </p>
      <dl class="facts">
        <div>
          <dt>Education</dt>
          <dd>
            {education.degree}, {education.school}. {education.expected}.
            <br />Top grades: {education.topGrades.join(', ')}.
          </dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>{languages.join(', ')}</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{profile.location}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 8px 64px;
  }

  .bio {
    max-width: 60ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .facts {
    display: grid;
    gap: 16px;
    margin: 32px 0 0;
    max-width: 60ch;
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 2px 0 0;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 4fr 8fr;
    }
  }
</style>
