---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagram from '../../components/case/Diagram.astro';
import Todo from '../../components/case/Todo.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const data = project.data;
const live = data.status === 'Live 24/7';
const compactShots = data.screenshots.every((shot) => shot.shape === 'phone');
---

<BaseLayout title={`${data.name}, a project by Priel Krishtal`} description={data.summary}>
  <article class="project">
    <header class="head wrap">
      <h1 style={`view-transition-name: project-${project.id}`}>{data.name}</h1>
      <p class="summary">{data.summary}</p>
      <dl class="meta">
        <div>
          <dt>Status</dt>
          <dd class:list={['status', { 'is-live': live }]}>{data.status}</dd>
        </div>
        <div>
          <dt>Runs on</dt>
          <dd>{data.host}</dd>
        </div>
        <div class="meta-stack">
          <dt>Stack</dt>
          <dd>{data.stack.join(', ')}</dd>
        </div>
      </dl>
      <p class="head-links">
        <a class="button" href={data.repo}>Code on GitHub</a>
      </p>
    </header>

    <section class="block wrap" aria-label="Architecture">
      <Diagram spec={data.diagram} name={data.name} />
    </section>

    <section class="block wrap" aria-labelledby="numbers-title">
      <h2 id="numbers-title" class="visually-hidden">Key numbers</h2>
      <dl class="numbers" style={`--count: ${data.numbers.length}`}>
        {
          data.numbers.map((number, index) => (
            <div data-reveal style={`--reveal-step: ${index}`}>
              <dt class="num">{number.value}</dt>
              <dd>{number.label}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="block wrap" aria-labelledby="decisions-title">
      <h2 id="decisions-title" class="block-title">Decisions</h2>
      <ul class="cards">
        {
          data.decisions.map((decision, index) => (
            <li class="card" data-reveal style={`--reveal-step: ${index}`}>
              <p>
                Chose <strong>{decision.chose}</strong> over {decision.over ?? <Todo>alternative considered</Todo>}
              </p>
              <p class="second">because {decision.because ?? <Todo>reason</Todo>}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class:list={['wrap', 'split', { 'is-split': compactShots }]}>
    <section class="block" aria-labelledby="reliability-title">
      <h2 id="reliability-title" class="block-title">Reliability</h2>
      <ul class="cards">
        {
          data.fixes.map((fix, index) => (
            <li class="card fix" data-reveal style={`--reveal-step: ${index}`}>
              <p class="broke-line">{fix.broke}</p>
              <p class="fix-line">{fix.fix ?? <Todo>what fixed it</Todo>}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="shots-title">
      <h2 id="shots-title" class="block-title">Screenshots</h2>
      <div class="shots">
        {
          data.screenshots.map((shot) => (
            <figure class={`shot shot-${shot.shape}`}>
              {shot.src ? (
                <img src={shot.src} alt={shot.alt ?? shot.label} loading="lazy" decoding="async" />
              ) : (
                <div class="frame">
                  <p>
                    <Todo>screenshot</Todo>
                  </p>
                </div>
              )}
              <figcaption>{shot.label}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>
    </div>

    <nav class="pager" aria-label="More">
      <div class="wrap pager-inner">
      <a class="next" href={`/work/${next.id}`}>
        <span>Next project</span>
        <b>{next.data.name}</b>
      </a>
      <p class="pager-links">
        <a class="link" href="/#work">Back to home</a>
        <a class="link" href={data.repo}>Code on GitHub</a>
      </p>
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  .head {
    padding-top: clamp(32px, 6vw, 80px);
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: -0.025em;
  }

  .summary {
    margin-top: 20px;
    max-width: 46ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin: 28px 0 0;
  }

  .meta dt {
    color: var(--ink-2);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .meta dd {
    margin: 2px 0 0;
  }

  .meta-stack {
    flex-basis: 100%;
    max-width: 70ch;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .status.is-live::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }

  .head-links {
    margin-top: 28px;
  }

  .block {
    padding-top: clamp(56px, 7vw, 104px);
  }

  .block-title {
    margin-bottom: 20px;
    font-size: var(--text-lead);
    font-weight: 600;
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
    margin: 0;
  }

  .numbers dt {
    font-size: var(--text-title);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .numbers dd {
    margin: 10px 0 0;
    max-width: 24ch;
    color: var(--ink-2);
  }

  .cards {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 18px 20px;
    background: var(--sheet);
    border-radius: 6px;
  }

  .card strong {
    font-weight: 600;
  }

  .second {
    margin-top: 2px;
    color: var(--ink-2);
  }

  .fix p {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    align-items: baseline;
    gap: 10px;
  }

  .fix p::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transform: translateY(-1px);
  }

  .broke-line::before {
    background: var(--fail);
  }

  .fix-line {
    margin-top: 6px;
  }

  .fix-line::before {
    background: var(--ok);
  }

  .shots {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    align-items: flex-start;
    gap: 20px;
  }

  .shot {
    margin: 0;
  }

  .shot-phone {
    flex: 0 1 260px;
  }

  .shot-portrait {
    flex: 0 1 220px;
  }

  .shot-wide {
    flex: 1 1 480px;
    max-width: 720px;
  }

  .frame,
  .shot img {
    display: grid;
    place-items: center;
    width: 100%;
    padding: 16px;
    background: var(--sheet);
    border-radius: 8px;
    text-align: center;
    font-size: var(--text-small);
  }

  .shot-phone .frame,
  .shot-phone img {
    aspect-ratio: 9 / 19.5;
    border-radius: 22px;
  }

  .shot-portrait .frame,
  .shot-portrait img {
    aspect-ratio: 3 / 4;
  }

  .shot-wide .frame,
  .shot-wide img {
    aspect-ratio: 16 / 10;
  }

  .shot figcaption {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: var(--text-small);
  }

  .pager {
    margin-top: clamp(72px, 9vw, 128px);
    background: var(--card);
    color: var(--card-ink);
  }

  .pager-inner {
    display: grid;
    gap: 24px;
    padding-block: clamp(56px, 8vw, 112px);
  }

  .pager :global(.link) {
    text-decoration-color: var(--extract);
  }

  .next {
    display: grid;
    gap: 4px;
    justify-self: start;
    text-decoration: none;
  }

  .next span {
    color: var(--card-ink-2);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .next b {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    text-decoration: underline;
    text-decoration-color: var(--extract);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  .pager-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-weight: 600;
  }

  .pager-links a {
    padding-block: 8px;
  }

  @media (min-width: 760px) {
    .numbers {
      grid-template-columns: repeat(var(--count, 4), minmax(0, 1fr));
    }

    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .split.is-split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 64px;
      align-items: start;
    }

    .split.is-split .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
