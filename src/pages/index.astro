---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDrawing from '../components/HeroDrawing.astro';
import Project from '../components/Project.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="Priel Krishtal, backend and LLM systems" description={`${profile.headline} ${profile.seeking}`}>
  <section class="hero wrap" aria-labelledby="hero-name">
    <div class="hero-copy">
      <h1 id="hero-name" class="name" translate="no">{profile.name}</h1>
      <p class="lede">
        {profile.headline}{' '}
        <span>{profile.seeking}</span>
      </p>
      <div class="actions">
        <a class="button" href="#contact" data-email={profile.emailEncoded}>Get in touch</a>
        <ul class="contact-links">
          <li><a class="link" href={profile.linkedin.url}>LinkedIn</a></li>
          <li><a class="link" href={profile.github.url}>GitHub</a></li>
        </ul>
      </div>
    </div>
    <HeroDrawing />
  </section>

  <Project id="filingbot" />
  <Project id="clarityscan" />
  <Skills />
  <About />
  <Contact />
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 32px;
    padding-top: clamp(32px, 7vw, 88px);
  }

  .name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    letter-spacing: -0.025em;
  }

  .lede {
    margin-top: 28px;
    max-width: 34ch;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
  }

  .lede span {
    color: var(--ink-2);
  }

  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .contact-links {
    display: flex;
    gap: 22px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-weight: 600;
  }

  .contact-links a {
    display: inline-block;
    padding-block: 10px;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 5fr 6fr;
      align-items: center;
      gap: 56px;
    }
  }
</style>
